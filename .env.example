# ─────────────────────────────────────────────────────────────────────────────
# ORQO Dashboard — Variables de entorno de producción
# Copia este archivo a .env.local (local) o configura en Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# URL pública del dashboard (sin slash final)
APP_URL=https://dashboard.orqo.io
NODE_ENV=production

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# URI de conexión a MongoDB Atlas (misma BD que usa orqo-core)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ── Auth (sesión JWT) ─────────────────────────────────────────────────────────
# Secreto para firmar sesiones — mínimo 32 chars aleatorios
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=ORQO <noreply@orqo.io>

# ── orqo-core (Management API) ────────────────────────────────────────────────
# URL interna de la Management API del core (servicio privado en Railway)
# En Railway puedes usar la URL interna: http://<service>.railway.internal:3002
CORE_MANAGEMENT_URL=https://api-management.orqo.io
# URL pública del webhook del core (servicio público en Railway)
CORE_WEBHOOK_URL=https://api.orqo.io
# Secreto compartido entre dashboard y core (debe coincidir con CORE_INTERNAL_SECRET del core)
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CORE_INTERNAL_SECRET=

# ── Meta / WhatsApp Embedded Signup ──────────────────────────────────────────
# Obtén estos valores desde developers.facebook.com → tu App → WhatsApp → Embedded Signup
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
META_APP_SECRET=

# ── Google OAuth (opcional) ───────────────────────────────────────────────────
# Habilita login con Google. Si no se configura, solo se usa email/password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Visibilidad del botón Google en UI (true/false)
NEXT_PUBLIC_GOOGLE_CONFIGURED=false

# ── Multi-tenant (opcional) ───────────────────────────────────────────────────
# Dominio base para resolución de workspace por subdominio
# Ej: "orqo.io" → "cliente.orqo.io" resuelve al workspace "cliente"
TENANT_BASE_DOMAIN=orqo.io
# Workspace ID por defecto cuando no hay subdominio de tenant
DEFAULT_WORKSPACE_ID=default

# ── LLM fallback (opcional) ───────────────────────────────────────────────────
# API key de OpenRouter para modelos de fallback del dashboard
OPENROUTER_API_KEY=
# API key gratuita de ORQO para workspaces en plan free (internal)
ORQO_FREE_OPENROUTER_API_KEY=

# ── Logs ──────────────────────────────────────────────────────────────────────
# Días de retención de logs de actividad (default: 90)
LOG_RETENTION_DAYS=90
